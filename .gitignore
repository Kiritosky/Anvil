# Anvil ist ein reines SwiftPM-Paket ohne Xcode-Projekt. Was hier steht, ist
# das, was hier tatsächlich entsteht — keine Vorlage für Projekte, die es nicht
# gibt.

# Build
.build/
.swiftpm/
*.dSYM
*.dSYM.zip

# Erzeugte Artefakte
Anvil.app/
*.zip

# Xcode, falls jemand das Paket dort öffnet
xcuserdata/
*.xcuserstate
*.hmap

# macOS
.DS_Store
